# code-assistant LLM configuration -- example. Copy to `.env` and edit.
#
# This file lists the ENVIRONMENT VARIABLE NAMES the resolver reads. It holds
# NO secret values. `.env` is git-ignored; never commit real credentials.
#
# Precedence (lowest -> highest):
#     config/defaults.yaml   <   environment (this file)   <   CLI flags / overrides
#
# See `shared.llm_config` and docs/building_hybrid_vscode_continue.md.

# --- provider selection -----------------------------------------------------
# One of: ollama | openai | anthropic | huggingface
# LLM_PROVIDER=ollama
# Role-specific providers override the generic one (mix local + API per role):
# LLM_ANALYSIS_PROVIDER=ollama
# LLM_REASONING_PROVIDER=openai
# LLM_GENERATION_PROVIDER=ollama

# --- model selection --------------------------------------------------------
# LLM_MODEL=deepseek-coder:6.7b            # global default model
# LLM_ANALYSIS_MODEL=qwen3:14b             # R1 code analysis
# LLM_REASONING_MODEL=deepseek-r1:14b      # R2 deep reasoning
# LLM_GENERATION_MODEL=deepseek-coder:6.7b # code generation

# --- endpoint and scalars ---------------------------------------------------
# LLM_API_ENDPOINT=http://localhost:11434
# LLM_TIMEOUT=600
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2048

# --- API keys (values only; read from the environment, never stored) --------
# Set the one that matches your provider. Leave blank to use local Ollama.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HUGGINGFACE_API_KEY=
# HF_TOKEN=
# OLLAMA_API_KEY=
# LLM_API_KEY=
